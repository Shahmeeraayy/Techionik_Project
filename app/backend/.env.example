APP_ENV=development
# Required: Supabase Postgres connection string.
# Use Direct connection for migrations/long-running servers when IPv6 is available:
# DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# Use Supavisor Session Pooler when IPv4 support is needed:
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# Hosted Postgres URLs like postgres://... are also accepted and auto-normalized.
JWT_SECRET_KEY=change-me-dev-only
SUPABASE_JWT_SECRET=
JWT_ALGORITHM=HS256
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=SM2 electronics
TENANT_HOST_SUFFIX=dispatchiq.com
TENANT_CACHE_PREFIX=dispatchiq
COMPANY_LOGO_URL=
COMPANY_NAME=SM2 electronics
COMPANY_STREET_ADDRESS=123 Dispatch Ave
COMPANY_CITY=Quebec
COMPANY_STATE=QC
COMPANY_ZIP_CODE=G1A 1A1
COMPANY_PHONE=+1-418-555-0100
COMPANY_EMAIL=billing@sm2dispatch.com
COMPANY_WEBSITE=https://www.sm2dispatch.com
ADMIN_EMAIL=admin@sm2dispatch.com
ADMIN_DEFAULT_PASSWORD=admin123
