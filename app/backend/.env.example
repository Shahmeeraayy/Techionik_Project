APP_ENV=development
# PostgreSQL is required for the final NexusOps backend runtime.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/nexusops
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/nexusops_test
# Hosted Postgres URLs like postgres://... are accepted and auto-normalized.
JWT_SECRET_KEY=change-me-dev-only
SUPABASE_JWT_SECRET=
JWT_ALGORITHM=HS256
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX=https://.*\\.vercel\\.app
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=NexusOps
TENANT_HOST_SUFFIX=nexusops.app
TENANT_CACHE_PREFIX=nexusops
COMPANY_LOGO_URL=
COMPANY_NAME=NexusOps
COMPANY_STREET_ADDRESS=123 NexusOps Ave
COMPANY_CITY=Quebec
COMPANY_STATE=QC
COMPANY_ZIP_CODE=G1A 1A1
COMPANY_PHONE=+1-418-555-0100
COMPANY_EMAIL=billing@nexusops.com
COMPANY_WEBSITE=https://www.nexusops.com
CUSTOMER_PORTAL_BASE_URL=https://www.nexusops.com
ADMIN_EMAIL=admin@nexusops.com
ADMIN_DEFAULT_PASSWORD=admin123
SUPER_ADMIN_EMAIL=root@nexusops.com
SUPER_ADMIN_DEFAULT_PASSWORD=superadmin123
SUPER_ADMIN_FULL_NAME=Platform Owner

# SMTP — required for automatic booking confirmation emails.
# Gmail: set SMTP_USERNAME to your Gmail address and SMTP_PASSWORD to a Gmail App Password.
EMAIL_PROVIDER=demo
EMAIL_API_KEY=
EMAIL_FROM_DOMAIN=nexusops.app
EMAIL_REPLY_TO=
EMAIL_ENABLED=true
# QA/testing-only recipient for notification delivery checks. Remove or disable before production.
NOTIFICATION_TEST_MODE=true
NOTIFICATION_TEST_RECIPIENT=muhammad.daniyal@techionik.com

# Optional SMTP transport for platform email. Leave blank for demo queue mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=billing@nexusops.com
SMTP_FROM_NAME=NexusOps
